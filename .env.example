# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Merknaam (site, bot, e-mails, OG-afbeeldingen). Leeg = "Orcawatch"
NEXT_PUBLIC_BRAND_NAME=
# Taal van de bot: en (standaard) of nl
BOT_LANG=en

# --- Telegram (fase 1) ---
# Van @BotFather
TELEGRAM_BOT_TOKEN=
# Zelfgekozen random string (A-Z a-z 0-9 _ -, max 256). Genereer met: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Komma-gescheiden Telegram user-IDs die altijd admin zijn (check je ID via @userinfobot)
TELEGRAM_ADMIN_IDS=
# ID van je testgroep (negatief getal, bv. -1001234567890). Kan ook via /setup in de groep.
TELEGRAM_CHAT_ID=

# --- Supabase (fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side! Nooit NEXT_PUBLIC_ ervoor zetten.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana / Helius (fase 2) ---
HELIUS_API_KEY=
# Zelfgekozen string (min. 16 tekens); Helius stuurt hem mee in de Authorization header
HELIUS_WEBHOOK_AUTH=
# Wordt geprint door `npm run webhooks:register`
HELIUS_WEBHOOK_ID=

# --- Ethereum / Alchemy + Etherscan (fase 3) ---
ALCHEMY_API_KEY=
# "Auth token" uit het Alchemy-dashboard (voor de Notify API)
ALCHEMY_AUTH_TOKEN=
# Signing key van de Address Activity webhook
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Wordt geprint door `npm run webhooks:register`
ALCHEMY_WEBHOOK_ID=
ETHERSCAN_API_KEY=

# --- Analyse (fase 5) ---
TAVILY_API_KEY=
# AI-samenvatting: Groq (gratis tier, console.groq.com → API Keys)
GROQ_API_KEY=
# Kijk op console.groq.com/docs/models welke modellen beschikbaar zijn
GROQ_MODEL=llama-3.3-70b-versatile
# Voor screenshot-analyse (moet een vision-model zijn)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optioneel, alleen gebruikt als GROQ_API_KEY leeg is
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Cron (fase 6) ---
# Vercel stuurt dit mee als Bearer token naar cron-routes
CRON_SECRET=

# --- Website (fase 8-9) ---
# Username van je bot zonder @ (voor "Koppel Telegram")
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=OrcawatchAlertsBot
# Link naar het gratis publieke kanaal, bv. https://t.me/jouwkanaal
NEXT_PUBLIC_TELEGRAM_PUBLIC_URL=
# Chat-ID van dat publieke kanaal (bot moet admin zijn); krijgt alerts 15 min vertraagd
TELEGRAM_PUBLIC_CHANNEL_ID=
# Wie /admin mag openen (komma-gescheiden e-mailadressen)
ADMIN_EMAILS=
# Alleen lokaal voor design-review zonder database. NOOIT in productie.
DEMO_DATA=

# --- E-mail-alerts (optioneel, resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Whale Alert <alerts@jouwdomein.nl>"

# --- Stripe (fase 10) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price-IDs (price_...) van je Pro-product, maand en jaar
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Getoonde prijzen op de site (moeten gelijk zijn aan Stripe)
NEXT_PUBLIC_PRICE_MONTHLY_EUR=19
NEXT_PUBLIC_PRICE_YEARLY_EUR=149
# Chat-ID van de privé Pro-groep (bot admin met "uitnodigen" + "verbannen")
TELEGRAM_PRO_GROUP_ID=
