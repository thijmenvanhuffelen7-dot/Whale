# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (fase 1) ---
# Van @BotFather
TELEGRAM_BOT_TOKEN=
# Zelfgekozen random string (A-Z a-z 0-9 _ -, max 256). Genereer met: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Komma-gescheiden Telegram user-IDs die altijd admin zijn (check je ID via @userinfobot)
TELEGRAM_ADMIN_IDS=
# ID van je testgroep (negatief getal, bv. -1001234567890). Kan ook via /setup in de groep.
TELEGRAM_CHAT_ID=

# --- Supabase (fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side! Nooit NEXT_PUBLIC_ ervoor zetten.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana / Helius (fase 2) ---
HELIUS_API_KEY=
# Zelfgekozen string (min. 16 tekens); Helius stuurt hem mee in de Authorization header
HELIUS_WEBHOOK_AUTH=
# Wordt geprint door `npm run webhooks:register`
HELIUS_WEBHOOK_ID=

# --- Ethereum / Alchemy + Etherscan (fase 3) ---
ALCHEMY_API_KEY=
# "Auth token" uit het Alchemy-dashboard (voor de Notify API)
ALCHEMY_AUTH_TOKEN=
# Signing key van de Address Activity webhook
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Wordt geprint door `npm run webhooks:register`
ALCHEMY_WEBHOOK_ID=
ETHERSCAN_API_KEY=

# --- Analyse (fase 5) ---
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Cron (fase 6) ---
# Vercel stuurt dit mee als Bearer token naar cron-routes
CRON_SECRET=

# --- Stripe (fase 10) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
TELEGRAM_PRO_GROUP_ID=
